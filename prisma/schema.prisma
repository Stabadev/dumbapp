generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  status    String   @default("NOUVEAU")
  createdAt DateTime @default(now())
}
